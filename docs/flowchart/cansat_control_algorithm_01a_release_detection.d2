title: "CanSat 制御アルゴリズム 1a: 放出・降下判定"
direction: down

classes: {
  phase: { style.fill: "#E8F2FF"; style.stroke: "#2459A6"; style.border-radius: 4 }
  decision: { shape: diamond; style.fill: "#FFF7D6"; style.stroke: "#8A6D00" }
  action: { style.fill: "#F8F8F8"; style.stroke: "#555555"; style.border-radius: 2 }
  terminal: { shape: oval; style.fill: "#EAF8EA"; style.stroke: "#2F7D32" }
}

start: "START\nmain.py 実行" { class: terminal }
init: "初期化\nPhase0開始\n制御周期 0.1 s\nログ周期 0.20 s" { class: action }
p0: "Phase0\n高度・加速度測定\nBMP180 / BNO055\nモータ停止" { class: phase }
valid: "センサ更新遅れ\n<= 1.5 s ?" { class: decision }
ref: "最初の有効高度を\n基準高度として保存" { class: action }
drop: "高度低下\n> 20.0 m ?" { class: decision }
impact: "衝撃検知 ?\n加速度差 >= 6.0 m/s^2\n2サンプル連続\nまたは 絶対値 > 30.0 m/s^2" { class: decision }
hold: "放出候補をラッチ\n30.0 s保持" { class: action }
timeout: "Phase0\n120 s超過 ?" { class: decision }
to_p1: "Phase1へ\nパラシュート分離開始" { class: terminal }

start -> init -> p0 -> valid
valid -> ref: "Yes"
valid -> timeout: "No"
ref -> drop
drop -> hold: "Yes"
drop -> impact: "No"
impact -> hold: "Yes"
impact -> timeout: "No"
timeout -> p0: "No"
hold -> to_p1: "30.0 s保持"
timeout -> to_p1: "Yes"

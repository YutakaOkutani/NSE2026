title: "CanSat 制御アルゴリズム 3/3: 画像探索・接近・ゴール"
direction: down

classes: {
  phase: { style.fill: "#E8F2FF"; style.stroke: "#2459A6"; style.border-radius: 4 }
  decision: { shape: diamond; style.fill: "#FFF7D6"; style.stroke: "#8A6D00" }
  action: { style.fill: "#F8F8F8"; style.stroke: "#555555"; style.border-radius: 2 }
  terminal: { shape: oval; style.fill: "#EAF8EA"; style.stroke: "#2F7D32" }
  fallback: { style.fill: "#FFECEC"; style.stroke: "#A33A3A"; style.border-radius: 2 }
}

start: "Phase4開始\nGPS距離 < 3.0 m\nまたは Phase3累積超過" { class: terminal }

p4_start: "Phase4\n画像探索・整列\nカメラ有効\nモータ周期 0.02 s" { class: phase }
p4_gps_far: "GPS有効 かつ\nゴール距離 > 10.0 m ?" { class: decision }
p4_back_p3: "Phase3へ戻る\nGPS航行再開" { class: fallback }
p4_cam_dead: "カメラ停止 >= 30.0 s\nかつ 試行 >= 3回\nまたは 探索 >= 60 s ?" { class: decision }
p4_timeout: "探索 >= 60 s ?" { class: decision }
p4_detect: "コーン確定 ?\nprob > 0.20\n|cone_dir - 0.5| <= 0.42\n方向差 <= 0.14\n2フレーム連続\nまたは 到達判定prob > 0.28" { class: decision }
p4_seen: "制御上コーンあり ?\nprob > 0.20\nまたは 到達判定" { class: decision }
p4_center: "中心誤差\n<= 0.04 ?\nフィルタ alpha = 0.72" { class: decision }
p4_search: "未検出\n左ピボット探索\n外輪45 %, 内輪0 %\nランプ0.06 s" { class: action }
p4_forward: "中央付近\n左右80 %で前進\nランプ0.06 s" { class: action }
p4_pivot: "中心へ整列\n外輪100 %, 内輪0 %\nランプ0.06 s" { class: action }
p4_timeout_p5: "Phase5へ\n理由: Phase4タイムアウト" { class: fallback }

p5_start: "Phase5\n画像接近\n通常45 s\nPhase4タイムアウト後20 s" { class: phase }
p5_gps_far: "GPS有効 かつ\nゴール距離 > 10.0 m ?" { class: decision }
p5_back_p3: "Phase3へ戻る" { class: fallback }
p5_cam_dead: "カメラ停止 >= 30.0 s\nかつ 試行 >= 3回\nまたは 接近時間超過 ?" { class: decision }
p5_detect: "コーン検出 ?\nprob > 0.18\nまたは 到達判定prob > 0.30" { class: decision }
p5_lost: "見失い\n>= 10フレーム ?" { class: decision }
p5_back_p4: "Phase4へ戻る\n再探索" { class: fallback }
p5_reached: "到達確定 ?\n到達判定 true\nprob > 0.30\n8フレーム連続" { class: decision }
p5_error: "操舵誤差\nerror = filtered_dir - 0.5\nフィルタ alpha = 0.72" { class: action }
p5_straight: "|error| <= 0.03 ?" { class: decision }
p5_forward: "直進接近\n左右80 %\nランプ0.05 s" { class: action }
p5_curve: "曲線接近\nturn = min(22, |error|*52)\n外輪 = 80 + turn\n内輪 = max(80 - turn, 44)" { class: action }
p5_timeout: "接近タイムアウト ?" { class: decision }

p6: "Phase6\n最終突入\n25 %, 2.5 s前進" { class: phase }
p7: "Phase7\nモータ停止\n最終ログ保存\nミッション終了" { class: terminal }

start -> p4_start -> p4_gps_far
p4_gps_far -> p4_back_p3: "Yes"
p4_gps_far -> p4_cam_dead: "No"
p4_cam_dead -> p4_back_p3: "Yes"
p4_cam_dead -> p4_timeout: "No"
p4_timeout -> p4_timeout_p5: "Yes"
p4_timeout -> p4_detect: "No"
p4_detect -> p5_start: "Yes"
p4_detect -> p4_seen: "No"
p4_seen -> p4_search: "No"
p4_seen -> p4_center: "Yes"
p4_center -> p4_forward: "Yes"
p4_center -> p4_pivot: "No"
p4_search -> p4_start
p4_forward -> p4_start
p4_pivot -> p4_start
p4_timeout_p5 -> p5_start

p5_start -> p5_gps_far
p5_gps_far -> p5_back_p3: "Yes"
p5_gps_far -> p5_cam_dead: "No"
p5_cam_dead -> p5_back_p3: "Yes"
p5_cam_dead -> p5_detect: "No"
p5_detect -> p5_lost: "No\n見失い数+1"
p5_lost -> p5_back_p4: "Yes"
p5_lost -> p5_timeout: "No"
p5_back_p4 -> p4_start
p5_detect -> p5_reached: "Yes\n見失い数リセット"
p5_reached -> p6: "Yes"
p5_reached -> p5_error: "No"
p5_error -> p5_straight
p5_straight -> p5_forward: "Yes"
p5_straight -> p5_curve: "No"
p5_forward -> p5_start
p5_curve -> p5_start
p5_timeout -> p6: "Yes\n強制ゴール"
p5_timeout -> p5_start: "No"
p6 -> p7

# Copy to mission.env on each Raspberry Pi. This file is safe as-is:
# radio control stays disabled until CANSAT_RADIO_CONTROL is set to mission.
# main.py reads ./mission.env automatically in both manual and systemd runs.
# Wi-Fi control is disabled unless this value is exactly "mission".
CANSAT_RADIO_CONTROL=off

# Launch-day / launch-like test value:
# CANSAT_RADIO_CONTROL=mission

# Seconds to show the pre-off LED signal after sensors/logging are initialized.
CANSAT_RADIO_PRE_OFF_DELAY_SEC=3

# Absolute failsafe from Wi-Fi-off time. Keep this at or below TIMEOUT_PHASE_0
# unless the launch procedure intentionally needs a longer radio-silent window.
# Use a shorter value such as 30 only for short Wi-Fi restore tests.
CANSAT_RADIO_RESTORE_TIMEOUT_SEC=180

# Use sudo -n before rfkill commands. The systemd mission service runs as pi,
# so keep this at 1 after /etc/sudoers.d/cansat-rfkill grants passwordless
# rfkill to the mission user. It has no effect while CANSAT_RADIO_CONTROL=off.
CANSAT_RADIO_USE_SUDO=1

# For service plumbing tests only. Commands are printed but not executed.
CANSAT_RADIO_DRY_RUN=0

[Unit]
Description=CanSat main mission

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/NSE2026
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/pi/venv/bin/python /home/pi/NSE2026/main.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
